# Copie este archivo como backend/.env y complete los valores reales (nunca suba .env).
# Cadena de conexión de PostgreSQL (en producción: Supabase).
DATABASE_URL=postgresql://usuario:clave@host:5432/shiftcash
# Clave para firmar los JWT: use una cadena aleatoria larga.
SECRET_KEY=cambie-esta-clave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# URL pública del backend (se usa para armar la URL de las fotos de perfil).
BACKEND_URL=http://localhost:8000
